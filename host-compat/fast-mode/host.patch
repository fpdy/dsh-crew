diff --git a/packages/llm/llm/tests/service-tier.spec.ts b/packages/llm/llm/tests/service-tier.spec.ts
new file mode 100644
--- /dev/null
+++ b/packages/llm/llm/tests/service-tier.spec.ts
@@ -0,0 +1,140 @@
+/** Per-call tiers are explicit, registration-bound controls and optional observations. */
+import { afterEach, describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import LlmRuntime, { AssistantStreamAccumulator, expandAssistantStream, LlmAdapter } from '../src/index.ts'
+import type { GenerateOptions, LlmResolvedModelInfo, StreamChunk } from '../src/types.ts'
+import { callConfigEquals } from '../src/call-config.ts'
+import { Session, SessionId, SessionSeq } from '@deepseek-ai/dsh-session'
+
+const contexts: Context[] = []
+afterEach(async () => { await Promise.all(contexts.splice(0).map(ctx => ctx.fiber.dispose())) })
+
+class TierAdapter extends LlmAdapter {
+  requests: GenerateOptions[] = []
+  constructor(readonly serviceTiers?: readonly ('priority')[]) { super() }
+  override resolveModel(provider: string, model: string): Promise<LlmResolvedModelInfo> {
+    return Promise.resolve({ provider, id: model, name: model,
+      ...this.serviceTiers === undefined ? {} : { serviceTiers: this.serviceTiers },
+    })
+  }
+  async * stream(options: GenerateOptions): AsyncIterable<StreamChunk> {
+    this.requests.push(options)
+    yield { type: 'finish', reason: { kind: 'stop' } }
+  }
+}
+async function runtime(adapter: TierAdapter): Promise<Context> {
+  const ctx = new Context()
+  contexts.push(ctx)
+  await ctx.plugin(LlmRuntime)
+  ctx.llm.registerAdapter(['route'], adapter)
+  return ctx
+}
+async function collect(stream: AsyncIterable<StreamChunk>): Promise<StreamChunk[]> {
+  const chunks: StreamChunk[] = []
+  for await (const chunk of stream) chunks.push(chunk)
+  return chunks
+}
+
+describe('explicit service tier', () => {
+  it('compares omission and priority without introducing a default', async () => {
+    const base = { provider: 'route', model: 'model' }
+    expect(callConfigEquals(base, { ...base, serviceTier: 'priority' })).toBe(false)
+    expect(callConfigEquals({ ...base, serviceTier: 'priority' }, { ...base, serviceTier: 'priority' })).toBe(true)
+    const ctx = await runtime(new TierAdapter(['priority']))
+    expect((await ctx.llm.prepareCall(base)).config).toEqual(base)
+  })
+
+  it('detaches and freezes metadata and controls, retaining one captured generation', async () => {
+    const tiers: ('priority')[] = ['priority']
+    const first = new TierAdapter(tiers)
+    const ctx = new Context()
+    contexts.push(ctx)
+    await ctx.plugin(LlmRuntime)
+    const dispose = ctx.llm.registerAdapter(['route'], first)
+    let calls = 0
+    const prepared = await ctx.llm.prepareCall({ provider: 'route', model: 'model', maxTokens: 123 }, undefined, (controls, model) => {
+      calls++
+      expect(Object.isFrozen(controls)).toBe(true)
+      expect(Object.isFrozen(model.serviceTiers)).toBe(true)
+      const serviceTier = model.serviceTiers?.[0]
+      if (serviceTier === undefined) throw new Error('missing fixture tier capability')
+      return { ...controls, serviceTier }
+    })
+    expect(Object.isFrozen(prepared.config)).toBe(true)
+    expect(prepared.adapterDefaults).toEqual({})
+    expect(() => prepared.stream({ provider: 'route', model: 'model', maxTokens: 123, messages: [] }))
+      .toThrow(expect.objectContaining({ code: 'INVALID_PREPARED_CALL' }))
+    tiers.splice(0)
+    dispose()
+    const replacement = new TierAdapter()
+    ctx.llm.registerAdapter(['route'], replacement)
+    await collect(prepared.stream({ ...prepared.config, messages: [] }))
+    expect(first.requests[0]?.serviceTier).toBe('priority')
+    expect(replacement.requests).toEqual([])
+    expect(calls).toBe(1)
+    expect(() => prepared.stream({ ...prepared.config, messages: [] }))
+      .toThrow(expect.objectContaining({ code: 'INVALID_PREPARED_CALL' }))
+  })
+
+  it.each([undefined, []])('rejects unsupported tier before preparation or stream I/O: %j', async (tiers) => {
+    const adapter = new TierAdapter(tiers)
+    const ctx = await runtime(adapter)
+    const config = { provider: 'route', model: 'model', serviceTier: 'priority' as const }
+    await expect(ctx.llm.prepareCall(config)).rejects.toMatchObject({ code: 'UNSUPPORTED_SERVICE_TIER' })
+    expect(await collect(ctx.llm.stream({ ...config, messages: [] })))
+      .toMatchObject([{ type: 'finish', reason: { kind: 'error', failure: { code: 'UNSUPPORTED_SERVICE_TIER' } } }])
+    expect(adapter.requests).toEqual([])
+  })
+
+  it('validates malformed adapter capability metadata', async () => {
+    const adapter = new TierAdapter(['priority'])
+    Object.assign(adapter, { serviceTiers: ['auto'] })
+    const ctx = await runtime(adapter)
+    await expect(ctx.llm.resolveModelInfo('route', 'model')).rejects.toMatchObject({ code: 'INVALID_MODEL_INFO' })
+  })
+
+  it('restores priority headers and rejects unknown durable controls', () => {
+    const event = { type: 'request/header', seq: SessionSeq(0), time: 1,
+      data: { reason: 'initial', header: { config: { provider: 'route', model: 'model', serviceTier: 'priority' } } } } as const
+    expect(Session.create(SessionId('tier-header'), [event]).snapshotEvents()[0]).toEqual(event)
+    for (const serviceTier of ['auto', '', 1, null, {}]) {
+      const invalid = structuredClone(event)
+      Object.assign(invalid.data.header.config, { serviceTier })
+      expect(() => Session.create(SessionId('tier-invalid'), [invalid])).toThrow('invalid serviceTier')
+    }
+  })
+})
+
+describe('compact response tier observation', () => {
+  it('round-trips a bounded terminal scalar and retains unknown as absent', () => {
+    const accumulator = new AssistantStreamAccumulator()
+    accumulator.push({ time: 1, chunk: { type: 'finish', reason: { kind: 'stop' }, responseServiceTier: 'priority' } })
+    expect(expandAssistantStream(accumulator.snapshot())[0]?.chunk).toEqual({
+      type: 'finish', reason: { kind: 'stop' }, responseServiceTier: 'priority',
+    })
+    const old = [{ type: 'chunk' as const, time: 1, chunk: { type: 'finish' as const, reason: { kind: 'stop' as const } } }]
+    expect(expandAssistantStream(old)[0]?.chunk).not.toHaveProperty('responseServiceTier')
+    const bounded = new AssistantStreamAccumulator()
+    bounded.push({ time: 1, chunk: { type: 'finish', reason: { kind: 'stop' }, responseServiceTier: 'a'.repeat(64) } })
+    expect(expandAssistantStream(bounded.snapshot())[0]?.chunk).toHaveProperty('responseServiceTier', 'a'.repeat(64))
+  })
+
+  it.each(['', 'a'.repeat(65), 'priority\n', 'raw response', {}, 1, null])('rejects malformed persisted observation %j', (responseServiceTier) => {
+    const malformed = responseServiceTier === 'priority\n'
+      ? ['priority\n', 'priority\r', 'priority\u2028', 'priority\u2029',
+          ...['\n', '\r', '\u2028', '\u2029'].map(suffix => 'a'.repeat(64) + suffix)]
+      : [responseServiceTier]
+    for (const tier of malformed) {
+      const chunk: StreamChunk = { type: 'finish', reason: { kind: 'stop' } }
+      Object.assign(chunk, { responseServiceTier: tier })
+      expect(() => expandAssistantStream([{ type: 'chunk', time: 1, chunk }])).toThrow()
+      expect(() => new AssistantStreamAccumulator().push({ time: 1, chunk })).toThrow('responseServiceTier')
+    }
+  })
+
+  it('rejects observations on failed finishes', () => {
+    expect(() => new AssistantStreamAccumulator().push({ time: 1, chunk: {
+      type: 'finish', reason: { kind: 'error', failure: { message: 'failed', code: 'FIXTURE' } }, responseServiceTier: 'priority',
+    } })).toThrow('successful finish')
+  })
+})
